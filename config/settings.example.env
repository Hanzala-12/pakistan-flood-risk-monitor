# Copy this file to .env in the repo root and fill in what you have.
# Everything below has a documented fallback, so the app runs today with
# nothing filled in — see README.md "Data sourcing decisions".

# --- Satellite (Copernicus Data Space Ecosystem) ------------------------
# Free account: https://dataspace.copernicus.eu -> register.
# Leave all unset (or SATELLITE_PROVIDER=mock) to use the synthetic
# mock satellite signal instead.
#
# Needs TWO separate credential types (verified against the live API while
# building this — see app/ingestion/satellite_copernicus.py docstring):
#   1. CDSE_CLIENT_ID/SECRET: a Sentinel Hub OAuth client (Client Credentials
#      flow), created at https://shapps.dataspace.copernicus.eu/dashboard ->
#      "Sentinel Hub" -> User settings -> OAuth clients -> Create.
#      Covers OData *search* only.
#   2. CDSE_S3_ACCESS_KEY/SECRET_KEY: S3-compatible object storage keys,
#      created at https://eodata-s3keysmanager.dataspace.copernicus.eu/ ->
#      Add Credential. Covers the actual Sentinel-2 band downloads — the
#      Sentinel Hub OAuth token above gets a 401 "Token audience not
#      allowed" if you try to use it for downloads instead.
SATELLITE_PROVIDER=mock
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=
# CDSE_S3_ACCESS_KEY=
# CDSE_S3_SECRET_KEY=

# --- Database ------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/flood_risk.db

# --- Fusion weights (must sum to ~1.0; see app/fusion/risk.py) -----------
# FUSION_WEIGHT_WATER=0.34
# FUSION_WEIGHT_RAINFALL=0.33
# FUSION_WEIGHT_TERRAIN=0.33

# --- Scheduler ------------------------------------------------------------
# SCHEDULER_ENABLED=true
# REFRESH_HOUR_UTC=2

# --- CORS (comma-separated list is not supported by pydantic's default
# list parsing from env vars; edit app/config.py's default directly, or set
# this as a JSON array string) ---------------------------------------------
# CORS_ALLOW_ORIGINS=["*"]
