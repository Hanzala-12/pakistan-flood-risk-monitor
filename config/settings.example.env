# Copy this file to .env in the repo root and fill in what you have.
# Everything below has a documented fallback, so the app runs today with
# nothing filled in — see README.md "Data sourcing decisions".

# --- Satellite (Copernicus Data Space Ecosystem) ------------------------
# Free account: https://dataspace.copernicus.eu -> register -> create an
# OAuth client under your account's API access settings.
# Leave both unset (or SATELLITE_PROVIDER=mock) to use the synthetic
# mock satellite signal instead.
SATELLITE_PROVIDER=mock
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=

# --- Database ------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/flood_risk.db

# --- Fusion weights (must sum to ~1.0; see app/fusion/risk.py) -----------
# FUSION_WEIGHT_WATER=0.34
# FUSION_WEIGHT_RAINFALL=0.33
# FUSION_WEIGHT_TERRAIN=0.33

# --- Scheduler ------------------------------------------------------------
# SCHEDULER_ENABLED=true
# REFRESH_HOUR_UTC=2

# --- CORS (comma-separated list is not supported by pydantic's default
# list parsing from env vars; edit app/config.py's default directly, or set
# this as a JSON array string) ---------------------------------------------
# CORS_ALLOW_ORIGINS=["*"]
